{
  "manifest_version": 3,
  "name": "LinkedIn Cookie Sync",
  "version": "3.9.57",
  "description": "3.9.57-human-sim \u2014 Human Simulator hardcoded: scroll/dwell sul profilo prima del Messaggia, digitazione char-by-char 1 invio su 3 (typo+correzione 5%), rate limit 25-30/giorno + pausa 3-7 min ogni 5-8 invii + cooldown 25-65s. Mantiene autoclose 3.9.56.",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lovable.app/*",
        "https://*.lovableproject.com/*",
        "http://localhost:*/*",
        "*://localhost:*/*",
        "http://127.0.0.1:*/*",
        "*://127.0.0.1:*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "version_name": "3.9.57-human-sim"
}